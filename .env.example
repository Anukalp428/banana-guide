# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
PORT=5001

# MongoDB Connection String (Atlas Cloud Free M0 or Local)
# Cloud Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/farmer_connect
# Local Example: mongodb://localhost:27017/farmer_connect
MONGODB_URI=

